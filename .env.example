# Copy to .env and adjust. All values are optional; CLI flags override them.
DATAPREP_DATA_PATH=
DATAPREP_TARGET=
DATAPREP_DROP_COLS=
DATAPREP_TASK=auto
DATAPREP_RANDOM_STATE=42
DATAPREP_TEST_SIZE=0.2
DATAPREP_CV_FOLDS=5
DATAPREP_SCALER=standard
DATAPREP_ENCODER=onehot
DATAPREP_N_JOBS=-1
DATAPREP_RF_ESTIMATORS=100
DATAPREP_LR_MAX_ITER=1000
DATAPREP_OUTPUT_DIR=outputs
